              "content": "Returns pending follow requests received by the authenticated account.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "follow_requests"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "Maximum number of results to return (default 20, max 80)"
                }
              ],
              "variable": [
                {
                  "description": "Hostname of the Pixelfed instance",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
