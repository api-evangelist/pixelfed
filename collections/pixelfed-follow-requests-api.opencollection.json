{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pixelfed REST Accounts Follow Requests API",
    "version": "1.1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://{instance}/oauth/authorize",
      "accessTokenUrl": "https://{instance}/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Follow Requests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List follow requests",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}/api/v1/follow_requests",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return (default 20, max 80)"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://{instance}/oauth/authorize",
              "accessTokenUrl": "https://{instance}/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns pending follow requests received by the authenticated account."
        },
        {
          "info": {
            "name": "Accept follow request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}/api/v1/follow_requests/:id/authorize",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://{instance}/oauth/authorize",
              "accessTokenUrl": "https://{instance}/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Accept a pending follow request."
        },
        {
          "info": {
            "name": "Reject follow request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}/api/v1/follow_requests/:id/reject",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://{instance}/oauth/authorize",
              "accessTokenUrl": "https://{instance}/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Reject a pending follow request."
        }
      ]
    }
  ],
  "bundled": true
}