{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pixelfed REST Accounts Stories API",
    "version": "1.1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://{instance}/oauth/authorize",
      "accessTokenUrl": "https://{instance}/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Stories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get stories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}/api/v1.1/stories",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://{instance}/oauth/authorize",
              "accessTokenUrl": "https://{instance}/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns stories from followed accounts (Pixelfed-specific)."
        }
      ]
    }
  ],
  "bundled": true
}