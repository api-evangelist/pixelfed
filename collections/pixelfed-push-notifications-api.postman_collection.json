          "name": "Update Web Push subscription",
          "request": {
            "name": "Update Web Push subscription",
            "description": {
              "content": "Creates or updates a Web Push notification subscription.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1.1",
                "push",
                "update-subscription"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Hostname of the Pixelfed instance",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "read write follow push"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://{instance}/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://{instance}/oauth/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subscription\": {\n    \"endpoint\": \"<uri>\",\n    \"keys\": {\n      \"p256dh\": \"<string>\",\n      \"auth\": \"<string>\"\n    }\n  },\n  \"data\": {\n    \"alerts\": {\n      \"follow\": \"<boolean>\",\n      \"favourite\": \"<boolean>\",\n      \"reblog\": \"<boolean>\",\n      \"mention\": \"<boolean>\",\n      \"poll\": \"<boolean>\"\n    }\n  }\n}",
              "options": {
                "raw": {
